{
  "schema": 1,
  "key": "neoforge",
  "title": "NeoForge",
  "kind": "mods",
  "order": 2,
  "logo": "/assets/loader-neoforge.png",
  "blurb": "The Forge fork most 1.20.2+ packs moved to. Takes NeoForge mods; 1.20.1 also reads Forge ones.",
  "mod_directory": "mods",
  "source": "NeoForged",
  "java": {
    "from": "minecraft"
  },
  "install": {
    "fetch": "installer",
    "run": [
      "java",
      "-jar",
      "{installer}",
      "--installServer"
    ],
    "remove_after": [
      "{installer}",
      "{installer}.log"
    ],
    "timeout": 900
  },
  "startup": {
    "command": "java @user_jvm_args.txt @{args_file} nogui",
    "jvm_args_file": "user_jvm_args.txt",
    "legacy_command": "java {jvm} -jar {jar} nogui"
  },
  "boot": {
    "ready": "Done \\([\\d.]+s\\)!",
    "timeout": 600
  }
}
