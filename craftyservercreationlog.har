            "text": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1175 276\">\n  <defs>\n    <!-- The long base64 string is the font -->\n    <style type=\"text/css\">\n      @font-face {\n        font-family: 'OPTIBankGothic';\n        font-weight: 500;\n        src: url(data:font/opentype;charset=utf-8;base64,) format(\"opentype\");\n      }\n    </style>\n  </defs>\n\n  <!--<rect\n    x=\"0\"\n    y=\"0\"\n    width=\"100%\"\n    height=\"100%\"\n    class=\"crafty-svg-bg\"\n    fill=\"hsl(234, 24%, 17%)\"\n  />-->\n  <!-- group for the C stuff -->\n  <g>\n    <!-- green C -->\n    <path\n      d=\"\n        m 253 107\n        l 38 -15\n\n        q 0 -40 -40 -40\n        l -95 0\n        q -40 0 -40 40\n        l 0 90\n        q 0 40 40 40\n        l 95 0\n        q 40 0 40 -40\n\n        l -38 -20\n        l 0 28\n        l -100 0\n        l 0 -108\n        l 100 0\n        Z\n      \"\n      fill=\"hsl(160, 59%, 45%)\"\n    />\n    <!-- blue C -->\n    <path\n      d=\"\n        m 353 107\n        l -38 -15\n\n        q 0 -40 40 -40\n        l 95 0\n        q 40 0 40 40\n        l 0 90\n        q 0 40 -40 40\n        l -95 0\n        q -40 0 -40 -40\n\n        l 38 -20\n        l 0 28\n        l 100 0\n        l 0 -108\n        l -100 0      \n        Z\n      \"\n      fill=\"hsl(192, 99%, 45%)\"\n    />\n    <!-- line thing in middle of Cs -->\n    <path\n      d=\"\n        m 233 116\n\n        q -10 0 -10 10\n        l 0 19\n        q 0 10 10 10\n\n        l 140 0\n        q 10 0 10 -10\n        l 0 -19\n        q 0 -10 -10 -10\n\n        Z\n      \"\n      fill=\"hsl(266, 71%, 57%)\"\n    />\n  </g>\n  <!-- vertical separator -->\n  <rect\n    x=\"530\"\n    y=\"43\"\n    width=\"12\"\n    height=\"190\"\n    fill=\"hsl(266, 71%, 57%)\"\n  />\n  <!-- group for the text -->\n  <g>\n    <!-- CRAFTY text -->\n    <g fill=\"hsl(160, 59%, 45%)\">\n      <text\n        x=\"581\" y=\"108\"\n        font-size=\"4rem\"\n        class=\"font-OPTIBankGothi