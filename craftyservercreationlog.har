          "content": {
            "size": 664,
            "mimeType": "text/css",
            "text": "/**************************************************************/\n/* CSS for Page Footer */\n/**************************************************************/\na:hover {\n    text-decoration: none;\n}\n\n.blink-text {\n    color: var(--base-text);\n    font-weight: bold;\n    font-size: 2rem;\n    animation: blinkingText 2s infinite;\n}\n\n@keyframes blinkingText {\n    0% {\n        color: var(--base-text);\n    }\n\n    50% {\n        color: var(--red);\n    }\n\n    100% {\n        color: var(--base-text);\n    }\n}\n\n#kofiframe {\n    border: none;\n    width: 100%;\n    padding: 4px;\n    background: var(--deep-bg);\n}\n\n/**************************************************************/"
          },
