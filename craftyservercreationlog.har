            "size": 1354,
            "mimeType": "text/css",
            "text": ":root.ronald {\n    /*CHANGE THESE FOR THEMES*/\n    --tooltip-bg: white;\n    --select-bg: #dee0f4;\n    --card-banner-bg: white;\n    --deep-bg: yellow;\n    --dropdown-bg: red;\n    --ram-bg: #dfdfdf;\n    --base-text: black;\n    --outline: #383e5d;\n    /*END THEME VARIATION*/\n    --blue: #00aeef;\n    --indigo: #6610f2;\n    --purple: #ab8ce4;\n    --pink: #E91E63;\n    --red: #ff0017;\n    --orange: #fb9678;\n    --yellow: #ffd500;\n    --green: #3bd949;\n    --teal: #58d8a3;\n    --cyan: #57c7d4;\n    --white: #ffffff;\n    --white-smoke: #f3f5f6;\n    --gray: #6c757d;\n    --gray-light: #8ba2b5;\n    --gray-lightest: #f7f7f9;\n    --primary: #2196f3;\n    --secondary: #dde4eb;\n    --success: #19d895;\n    --info: #8862e0;\n    --warning: #ffaf00;\n    --danger: #ff6258;\n    --light: #fbfbfb;\n    --dark: #252c46;\n    --breakpoint-xs: 0;\n    --breakpoint-sm: 576px;\n    --breakpoint-md: 768px;\n    --breakpoint-lg: 992px;\n    --breakpoint-xl: 1200px;\n    --font-family-sans-serif: -apple-system, BlinkMacSystemFont, \"Segoe UI\",\n        \"Atkinson Hyperlegible Next\", \"Helvetica Neue\", Arial, \"Noto Sans\",\n        sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\",\n        \"Noto Color Emoji\";\n    --font-family-monospace: \"Atkinson Hyperlegible Mono\", SFMono-Regular, Menlo,\n        Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n}"
