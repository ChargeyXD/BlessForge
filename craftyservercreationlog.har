          "content": {
            "size": 6445,
            "mimeType": "text/css",
            "compression": 0,
            "text": ".animated-table {\n    width: 100%;\n    border-collapse: separate;\n    border-spacing: 0 8px;\n    border-bottom-right-radius: 8px;\n    border-bottom-left-radius: 8px;\n    background: var(--ram-bg);\n    padding: 8px;\n    cursor: pointer;\n}\n\n.row-select, .root-select {\n    appearance: none;\n    width: 20px;\n    height: 20px;\n    border: 2px solid var(--outline);\n    border-radius: 6px;\n    background: var(--deep-bg);\n    cursor: pointer;\n    position: relative;\n    transition: all 0.2s ease;\n    margin: 0;\n}\n\n.row-select:hover, .root-select:hover {\n    border-color: var(--info);\n    background: var(--card-banner-bg);\n}\n\n.row-select:checked, .root-select:checked {\n    background: var(--info);\n    border-color: var(--info);\n}\n\n.row-select:checked::after, .root-select:checked::after {\n    content: '';\n    position: absolute;\n    top: 2px;\n    left: 6px;\n    width: 4px;\n    height: 10px;\n    border: solid white;\n    border-width: 0 2px 2px 0;\n    transform: rotate(45deg);\n}\n\n.row-select:focus, .root-select:focus {\n    outline: none;\n    box-shadow: 0 0 0 3px rgba(136, 98, 224, 0.2);\n}\n\n.animated-table tbody tr {\n    background: var(--ram-bg);\n    border-radius: 10px;\n    overflow: visible;\n    transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n\n.animated-table tbody tr:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\n.animated-table td,\n.animated-table th {\n    position: relative;\n    z-index: 1;\n    padding: 12px 16px;\n    border: none;\n    background: transparent;\n    vertical-align: middle;\n}\n\n.animated-table tbody tr td:first-child::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: -100%;\n    width: 300%;\n    height: 100%;\n    border-radius: inherit;\n    background: linear-gradient(90deg,\n            rgba(255, 255, 255, 0) 0%,\n            var(--info) 50%,\n            rgba(255, 255, 255, 0) 100%);\n    transform: translateX(-100%);\n    z-index: 0;\n    pointer-events: none;\n}\n\n.animated-table tbody tr:hover td:first-child::before {\n    animation: shimmer 1.8s linear infinite;\n}\n\n.animated-table thead th::before {\n    content: none !important;\n    animation: none !important;\n}\n\n@keyframes shimmer {\n    0% {\n        transform: translateX(-100%);\n        opacity: 0%;\n    }\n\n    50% {\n        transform: translateX(0%);\n        opacity: 70%;\n    }\n\n    100% {\n        transform: translateX(100%);\n        opacity: 0%;\n    }\n}\n\n/* Skeleton row styling */\n.skeleton-row {\n    position: relative;\n    background: var(red);\n    border-radius: 10px;\n    overflow: hidden;\n    height: 40px;\n    /* approximate row height */\n}\n\n/* Skeleton lines in cells */\n.skeleton-line {\n    height: 16px;\n    /* text height */\n    border-radius: 8px;\n    background: var(--ram-bg);\n    /* base skeleton color */\n    position: relative;\n    overflow: hidden;\n    margin: 12px 0;\n    /* center vertically in the cell */\n}\n\n/* Shimmer animation */\n.skeleton-line::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: -100%;\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(90deg,\n            var(--ram-bg) 0%,\n            var(--primary) 50%,\n            var(--ram-bg) 100%);\n    animation: skelline 1.5s infinite;\n}\n\n@keyframes skelline {\n    0% {\n        transform: translateX(-100%);\n    }\n\n    100% {\n        transform: translateX(100%);\n    }\n}\n\n#drop-zone {\n    position: relative;\n    transition: background-color 0.3s ease, border 0.3s ease;\n}\n\n#drop-zone-overlay {\n    position: absolute;\n    inset: 0;\n    background: rgba(0, 0, 0, 0.5);\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    border-radius: 6px;\n    opacity: 0;\n    pointer-events: none;\n    /* always none! */\n    transition: opacity 0.2s ease;\n    z-index: 10;\n}\n\n#drop-zone-overlay img {\n    opacity: 0.9;\n}\n\n/* Active state */\n#drop-zone.drop-hover #drop-zone-overlay {\n    opacity: 1;\n}\n\n#status-icon {\n    position: sticky;\n    width: 20px;\n    bottom: 20px;\n    right: 20px;\n    z-index: 100;\n}\n\n#context-container {\n    background-color: var(--ram-bg);\n}\n\n.table-nav-container {\n    display: inline-block;\n    position: sticky;\n    top: 0;\n    gap: 8px;\n    background: var(--ram-bg);\n    border-top-left-radius: 8px;\n    border-top-right-radius: 8px;\n    padding: 8px 12px;\n    width: 100%;\n}\n\n#table-nav-buttons .btn {\n    background: transparent;\n    border: 2px solid var(--info);\n    color: var(--info);\n    opacity: 0.85;\n    transition: all 0.2s ease;\n    font-weight: 600;\n}\n\n#table-nav-buttons .btn:hover {\n    background: var(--info);\n    color: white;\n    opacity: 1;\n    transform: translateY(-1px);\n    box-shadow: 0 2px 6px rgba(136, 98, 224, 0.3);\n}\n\n#table-nav-buttons .btn:active {\n    transform: translateY(0);\n}\n\n#table-nav-buttons .btn-danger {\n    border-color: var(--danger);\n    color: var(--danger);\n}\n\n#table-nav-buttons .btn-danger:hover {\n    background: var(--danger);\n    color: white;\n    box-shadow: 0 2px 6px rgba(255, 98, 88, 0.3);\n}\n\n.tree-nav {\n    cursor: pointer;\n}\n\n/*  This code forces the main-panel to scroll\n    instead of the body so that the position \n    sticky on file-status will work\n*/\n\n.main-panel {\n    overflow: auto;\n    position: relative;\n    height: calc(100vh - 63px);\n    background-color: var(--deep-bg);\n}\n\n.content-wrapper {\n    padding-bottom: 0;\n}\n\nbody {\n    overflow: hidden;\n}\n\n#file-status {\n    --width: clamp(150px, 20vw, 300px);\n    position: sticky;\n    bottom: 1px;\n    left: calc(100% - var(--width) - 1.75em);\n    background-color: var(--deep-bg);\n    width: var(--width);\n    z-index: 100;\n    border-top-left-radius: 10px;\n    border-top-right-radius: 10px;\n    padding: 10px;\n    outline: 1px solid var(--outline);\n    cursor: pointer;\n}\n\n#status-caret {\n    float: right;\n    right: -10px;\n}\n\n#operation-total {\n    color: var(--deep-bg);\n}\n\n#table-nav-buttons button {\n    margin-bottom: 10px;\n}\n\n.files-progress {\n    margin-top: 7px;\n}\n\n.highlight-row {\n    background-color: var(--deep-bg) !important;\n}\n\n#file-status-content {\n    position: absolute;\n    bottom: 100%;\n    padding: 10px;\n    margin-bottom: -6px;\n    left: 0;\n    width: 100%;\n    max-height: 50vh;\n    overflow-y: auto;\n    overflow-x: hidden;\n    background-color: var(--deep-bg);\n    border: 1px solid var(--outline);\n    border-radius: 10px 10px 0 0;\n    z-index: 101;\n    display: block;\n}\n\n#get_more {\n    background-color: var(--card-banner-bg);\n    overflow: hidden;\n}"
