          "content": {
            "size": 684,
            "mimeType": "text/css",
            "text": ".sidebar {\n    height: 91vh;\n}\n\n.panel-settings {\n    color: var(--info) !important;\n}\n\n.mfa-warn {\n    text-align: center;\n}\n\n.mfa-warn-text {\n    line-height: 1.2;\n    border-radius: 10px;\n    padding: 5px;\n    margin: 5px;\n    outline: 3px solid var(--outline);\n}\n\n.mfa-warn-badge {\n    position: absolute;\n    -moz-transform: translate(-50%, -50%);\n    /* For Firefox */\n    -ms-transform: translate(-50%, -50%);\n    /* for IE */\n    -webkit-transform: translate(-50%, -50%);\n    /* For Safari, Chrome, iOS */\n    -o-transform: translate(-50%, -50%);\n}\n\n.mfa-light {\n    color: color-mix(in srgb, var(--warning) 20%, var(--danger) 80%);\n}\n\n.mfa-dark {\n    color: var(--warning);\n}"
          },
