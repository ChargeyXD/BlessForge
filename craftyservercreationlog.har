            "text": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1175 276\">\n  <defs>\n    <!-- The long base64 string is the font -->\n    <style type=\"text/css\">\n      @font-face {\n        font-family: 'OPTIBankGothic';\n        font-weight: 500;\n        src: url(data:font/opentype;charset=utf-8;base64,) format(\"opentype\");\n      }\n    </style>\n  </defs>\n\n  <!--<rect\n    x=\"0\"\n    y=\"0\"\n    width=\"100%\"\n    height=\"100%\"\n    class=\"crafty-svg-bg\"\n    fill=\"hsl(234, 24%, 17%)\"\n  />-->\n  <!-- group for the C stuff -->\n  <g>\n    <!-- green C -->\n    <path\n      d=\"\n        m 253 107\n        l 38 -15\n\n        q 0 -40 -40 -40\n        l -95 0\n        q -40 0 -40 40\n        l 0 90\n        q 0 40 40 40\n        l 95 0\n        q 40 0 40 -40\n\n        l -38 -20\n        l 0 28\n        l -100 0\n        l 0 -108\n        l 100 0\n        Z\n      \"\n      fill=\"hsl(160, 59%, 45%)\"\n    />\n    <!-- blue C -->\n    <path\n      d=\"\n        m 353 107\n        l -38 -15\n\n        q 0 -40 40 -40\n        l 95 0\n        q 40 0 40 40\n        l 0 90\n        q 0 40 -40 40\n        l -95 0\n        q -40 0 -40 -40\n\n        l 38 -20\n        l 0 28\n        l 100 0\n        l 0 -108\n        l -100 0      \n        Z\n      \"\n      fill=\"hsl(192, 99%, 45%)\"\n    />\n    <!-- line thing in middle of Cs -->\n    <path\n      d=\"\n        m 233 116\n\n        q -10 0 -10 10\n        l 0 19\n        q 0 10 10 10\n\n        l 140 0\n        q 10 0 10 -10\n        l 0 -19\n        q 0 -10 -10 -10\n\n        Z\n      \"\n      fill=\"hsl(266, 71%, 57%)\"\n    />\n  </g>\n  <!-- vertical separator -->\n  <rect\n    x=\"530\"\n    y=\"43\"\n    width=\"12\"\n    height=\"190\"\n    fill=\"hsl(266, 71%, 57%)\"\n  />\n  <!-- group for the text -->\n  <g>\n    <!-- CRAFTY text -->\n    <g fill=\"hsl(160, 59%, 45%)\">\n      <text\n        x=\"581\" y=\"108\"\n        font-size=\"4rem\"\n        class=\"font-OPTIBankGothic\"\n        font-family=\"'OPTIBankGothic', sans-serif\"\n        font-weight=\"bold\"\n      >C</text>\n      <text\n        x=\"678\" y=\"130\"\n        font-size=\"3.8rem\"\n        letter-spacing=\"1.85rem\"\n        transform=\"scale(1, 0.85)\"\n        class=\"font-OPTIBankGothic\"\n        font-family=\"'OPTIBankGothic', sans-serif\"\n        font-weight=\"bold\"\n      >RAFT</text>\n      <text\n        x=\"1005\" y=\"109\"\n        font-size=\"4rem\"\n        class=\"font-OPTIBankGothic\"\n        font-family=\"'OPTIBankGothic', sans-serif\"\n        font-weight=\"bold\"\n      >Y</text>\n    </g>\n    <!-- CONTROLLER text -->\n    <text\n      x=\"600\" y=\"170\"\n      class=\"font-OPTIBankGothic\"\n      font-family=\"'OPTIBankGothic', sans-serif\"\n      font-weight=\"bold\"\n      font-size=\"3.15rem\"\n      letter-spacing=\"1px\"\n      fill=\"hsl(192, 99%, 45%)\"\n    >CONTROLLER</text>\n    <!-- desc -->\n    <g>\n      <rect\n        x=\"585\"\n        y=\"180\"\n        width=\"478\"\n        height=\"33\"\n        fill=\"hsl(266, 71%, 57%)\"\n      />\n      <text\n        x=\"606\"\n        y=\"205\"\n        class=\"font-OPTIBankGothic\"\n        font-family=\"'OPTIBankGothic', sans-serif\"\n        font-weight=\"700\"\n        fill=\"hsl(234, 24%, 17%)\"\n        font-size=\"1.1rem\"\n        letter-spacing=\"2px\"\n      >TAKE CONTROL OF YOUR SERVERS</text>\n    </g>\n  </g>\n\n</svg>"
