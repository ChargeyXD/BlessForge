# The control plane's secrets. Copy to .env next to docker-compose.yml.
# Never commit the real one.

# The database password, used by both the api and postgres services.
# Generate one: openssl rand -base64 30
POSTGRES_PASSWORD=

# Your CurseForge key, as issued (format: raw keeps its '$' intact).
CURSEFORGE_API_KEY=

# Optional: an Ollama you run, for the troubleshooting assistant.
OLLAMA_URL=

# Encrypts the node tokens and the browser-signing key in the database.
# Required, and keep it: losing it means registering every node again.
# Generate one: openssl rand -hex 32
BLESSFORGE_SECRET=

# How the nodes' agents reach this panel, over WireGuard -- written into
# each agent's config when a node is registered. e.g. http://10.8.0.1:8710
PUBLIC_API_URL=
