# Copy to .env and fill in, then: docker compose up -d --build

# --- Required ---------------------------------------------------------

# What runs the servers: "agent" (the BlessForge node agents registered
# with this panel) or "mock" (in memory, for trying the interface).
ENGINE=mock

# CurseForge Core API key from https://console.curseforge.com/
# Paste it exactly as issued -- the '$' characters are part of the key.
# docker-compose.yml loads this file with `format: raw`, so the value is passed
# through verbatim and no escaping is needed. Wrapping it in single quotes or
# doubling each '$' also works, in case you copy the key into a plain
# `environment:` block (which is what the CasaOS install dialog writes) --
# there, Compose WILL expand '$name' and silently truncate an unescaped key.
# Example shape: CURSEFORGE_API_KEY=$2a$10$...  (never commit a real one)
CURSEFORGE_API_KEY=

# --- AI assistant (optional) ------------------------------------------

# Ollama-compatible endpoint used by the troubleshooting assistant: one YOU
# run. Blank (the default) turns the assistant off and nothing else needs it.
# See README "AI assistant" for running your own. Never point this at an
# endpoint somebody else operates: crash reports and mod lists go to it.
OLLAMA_URL=

# Set only if the endpoint sits behind an authenticating proxy.
OLLAMA_API_KEY=

# The other side of the assistant's endpoint switch. A local Ollama has no
# proxy in front of it, so a long crash report can go whole rather than being
# summarised to fit a 120s budget -- but it has to be running.
#
# In a container this must NOT be localhost: that is the container itself.
# docker-compose.yml sets it to http://host.docker.internal:11434, which the
# host-gateway alias resolves. Running BlessForge as a bare process, localhost
# is correct and is the default.
OLLAMA_LOCAL_URL=http://localhost:11434

# Qwen3-4B-Instruct: 2.5 GB, no thinking preamble, reliable JSON, and a 256k
# context -- which is what reading a whole crash report end to end needs.
# BlessForge can fetch it for you (Troubleshoot -> the model pill), or:
#   curl -X POST $OLLAMA_URL/api/pull -d '{"model":"qwen3:4b-instruct"}'
AI_MODEL=qwen3:4b-instruct

# Set false to hide the AI panel entirely.
AI_ENABLED=true

# Seconds to wait for the model.
AI_TIMEOUT=300

# --- Mod Roulette (optional) ------------------------------------------

# Catalogue pages (50 mods each) fetched per category when a roulette pool is
# built. Four gives ~3,000 candidates on a well-served version. Raising it
# broadens the pool and makes the first roll on a fresh version slower; pools
# are cached for three days per (version, loader, source).
ROULETTE_POOL_PAGES=4

# --- Performance tuning (optional) ------------------------------------

# BlessForge measures RAM and CPU from inside its own container. If the node
# is a DIFFERENT machine, set these to describe that machine instead,
# otherwise the optimizer will size heaps against the wrong host.
# HOST_RAM_GB=16
# HOST_CPU_COUNT=8

# --- Other (optional) -------------------------------------------------

# Modrinth is used as a second mod source and needs no key.
MODRINTH_ENABLED=true

# Parallel mod downloads while assembling a pack from its manifest.
DOWNLOAD_CONCURRENCY=8

# Seconds to allow a Forge/NeoForge loader installer to run.
SERVER_READY_TIMEOUT=900

# Default RAM (GB) for new instances when the pack states no preference.
DEFAULT_MEM_MIN=2
DEFAULT_MEM_MAX=6

# --- Imported pack exports (optional) ---------------------------------

# Size ceiling for a single "Import Export" upload, in MB. Exports that carry
# a world folder get large; this exists so a mis-drop cannot fill the volume.
# MAX_UPLOAD_MB=4096

# How many imported archives to keep in /data/uploads. Past this, the oldest
# are removed. Keeping them means re-installing a pack needs no second upload.
# MAX_UPLOADS=12

TZ=UTC
