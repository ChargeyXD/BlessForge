# Copy to .env and fill in, then: docker compose up -d --build

# --- Required ---------------------------------------------------------

# Crafty's web address, including scheme and port.
# Use the machine's LAN IP. Do NOT use 127.0.0.1/localhost: inside the
# container that points at the container itself, not at Crafty.
CRAFTY_URL=https://192.168.68.120:8443

# Crafty API token (Crafty > your user > API keys).
# The token's user needs: Server Creation, Files, Commands, Config.
CRAFTY_TOKEN=

# CurseForge Core API key from https://console.curseforge.com/
# Wrap in single quotes '...' or double each '$' to prevent Docker Compose variable expansion:
# Example: CURSEFORGE_API_KEY='$2a$10$...'
CURSEFORGE_API_KEY=''

# --- AI assistant (optional) ------------------------------------------

# Ollama endpoint used by the troubleshooting assistant. host.docker.internal
# resolves to the host thanks to extra_hosts in docker-compose.yml.
# Point it elsewhere if Ollama runs on another machine.
OLLAMA_URL=http://host.docker.internal:11434

# A 1-2 GB instruct model is plenty. Pull it first:
#   ollama pull qwen2.5:3b-instruct-q4_K_M
AI_MODEL=qwen2.5:3b-instruct-q4_K_M

# Set false to hide the AI panel entirely.
AI_ENABLED=true

# Seconds to wait for the model. Raise it on slow CPUs (no GPU).
AI_TIMEOUT=180

# --- Performance tuning (optional) ------------------------------------

# BlessForge measures RAM and CPU from inside its own container. If Crafty
# runs on a DIFFERENT machine, set these to describe that machine instead,
# otherwise the optimizer will size heaps against the wrong host.
# HOST_RAM_GB=16
# HOST_CPU_COUNT=8

# --- Other (optional) -------------------------------------------------

# Crafty uses a self-signed certificate out of the box, so this stays false
# unless you installed a real certificate.
CRAFTY_VERIFY_SSL=false

# Modrinth is used as a second mod source and needs no key.
MODRINTH_ENABLED=true

# Parallel mod downloads while assembling a pack from its manifest.
DOWNLOAD_CONCURRENCY=8

# Seconds to wait for Crafty to finish a Forge/NeoForge loader install.
SERVER_READY_TIMEOUT=900

# Default RAM (GB) for new instances when the pack states no preference.
DEFAULT_MEM_MIN=2
DEFAULT_MEM_MAX=6

TZ=UTC
