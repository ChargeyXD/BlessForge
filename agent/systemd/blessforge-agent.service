# The BlessForge node agent.
#
#   install -d -m 700 /etc/blessforge-agent
#   install -d -m 755 /srv/blessforge/servers
#   install -m 600 agent.toml /etc/blessforge-agent/agent.toml   # from the panel
#   python3 -m venv /opt/blessforge-agent/venv
#   /opt/blessforge-agent/venv/bin/pip install -r /opt/blessforge-agent/src/agent/requirements.txt
#   cp agent/systemd/blessforge-agent.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now blessforge-agent
#
# It runs as root because it talks to the Docker socket (which is root
# anyway) and hands server folders to the container user. Everything else
# is closed off below: it may write only the server folders and its own
# state, and it never gets new privileges itself.

[Unit]
Description=BlessForge node agent
Documentation=https://github.com/ChargeyXD/BlessForge/blob/main/dev/agent/README.md
After=network-online.target docker.service wg-quick@wg0.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Environment=BLESSFORGE_AGENT_CONFIG=/etc/blessforge-agent/agent.toml
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/blessforge-agent/src
ExecStart=/opt/blessforge-agent/venv/bin/python -m agent
Restart=always
RestartSec=5
# Servers get the configured stop_timeout to save their worlds on shutdown.
TimeoutStopSec=120
KillMode=mixed

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/blessforge -/run/docker.sock
StateDirectory=blessforge-agent
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
